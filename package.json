{
  "name": "billbox-client",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "formik": "^2.4.2",
    "moment": "^2.29.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "react-scripts": "5.0.1",
    "react-to-pdf": "^3.2.2",
    "sonner": "^2.0.8",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^8.57.1",
    "http-proxy-middleware": "^2.0.10",
    "prettier": "^3.4.2",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17",
    "wait-on": "^9.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
