# Leave this unset to use the /api proxy (setupProxy.js / vercel.json).
# Only set it if the API is on another domain (include /api at the end).
# REACT_APP_BACKEND_URL=https://your-api.vercel.app/api

# Where the dev server forwards /api (default http://localhost:5000)
# DEV_API_URL=http://localhost:5000
